' Shared style for all Attendance Management System diagrams
skinparam dpi 150
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam ArrowFontSize 11
skinparam ActorBorderColor #1F3864
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1F3864
skinparam UsecaseBackgroundColor #EAF0FA
skinparam RectangleBorderColor #1F3864
skinparam ComponentBorderColor #1F3864
skinparam ComponentBackgroundColor #FFF2CC
skinparam PackageBorderColor #7F8FA6
skinparam PackageBackgroundColor #F7F9FC
skinparam DatabaseBorderColor #1F3864
skinparam DatabaseBackgroundColor #E2EFDA
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #999999
skinparam ParticipantBorderColor #1F3864
skinparam ParticipantBackgroundColor #EAF0FA
skinparam SequenceLifeLineBorderColor #7F8FA6
skinparam SequenceGroupBorderColor #7F8FA6
skinparam EntityBorderColor #1F3864
skinparam EntityBackgroundColor #FFFFFF
skinparam ClassBorderColor #1F3864
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #EAF0FA
